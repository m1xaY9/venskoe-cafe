APP_ENV=local
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://venskoe:venskoe@localhost:5432/venskoe
# Токен DaData для подсказок адреса. Без него подсказки вернут 503, сайт работает.
DADATA_API_KEY=
# Доверенные прокси (CIDR через запятую). Если задано и запрос пришёл от такого адреса,
# IP гостя берётся из X-Forwarded-For. Пусто — доверяем только адресу соединения.
TRUSTED_PROXIES=
