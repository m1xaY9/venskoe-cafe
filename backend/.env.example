APP_ENV=local
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://venskoe:venskoe@localhost:5432/venskoe
# Токен DaData для подсказок адреса. Без него подсказки вернут 503, сайт работает.
DADATA_API_KEY=
# Доверенные прокси (CIDR через запятую). Если задано и запрос пришёл от такого адреса,
# IP гостя берётся из X-Forwarded-For. Пусто — доверяем только адресу соединения.
TRUSTED_PROXIES=
# Базовый адрес фронтенда для редиректов (страница заказа).
PUBLIC_BASE_URL=http://localhost:3000

# Интернет-эквайринг Сбербанка. Без SBER_USERNAME онлайн-оплата отключена.
SBER_BASE_URL=https://ecomtest.sberbank.ru/ecomm/gw/partner/api/v1
SBER_USERNAME=
SBER_PASSWORD=
# Корневой сертификат НУЦ Минцифры (Russian Trusted Root CA). Скачать с gosuslugi.ru/crt,
# положить рядом (в git не коммитить) и указать путь.
SBER_CA_FILE=
SBER_RETURN_URL=http://localhost:8080/api/payments/sber/return
SBER_FAIL_URL=http://localhost:8080/api/payments/sber/return
# Реквизиты чека 54-ФЗ — уточнить у владельца/кассы.
SBER_FFD_VERSION=1.05
SBER_TAX_SYSTEM=osn
SBER_VAT=6
SBER_INN=
